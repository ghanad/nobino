generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED_BY_USER
  CANCELLED_BY_ADMIN
  ALTERNATIVE_PROPOSED
}

enum AlternativeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum LunchReservationStatus {
  ACTIVE
  CANCELLED_BY_USER
  CANCELLED_BY_ADMIN
}

enum AnnouncementSeverity {
  NORMAL
  IMPORTANT
}

enum AnnouncementAudience {
  ALL
  USER
  MANAGER
  ADMIN
}

enum BaleDeliveryStatus {
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum CalendarDayOverrideMode {
  CLOSED
  NORMAL
  CUSTOM
}

enum CalendarDayTargetType {
  SYSTEMS
  LUNCH
  OFFICE
  MEETING_ROOM
}

enum ScheduleExceptionSource {
  MANUAL
  IRAN_HOLIDAY
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               UserRole  @default(USER)
  active             Boolean   @default(true)
  canViewLunchReport Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  reservations                     Reservation[]                   @relation("ReservationUser")
  meetingRoomReservations          MeetingRoomReservation[]        @relation("MeetingRoomReservationUser")
  deskReservations                 DeskReservation[]               @relation("DeskReservationUser")
  lunchReservations                LunchReservation[]              @relation("LunchReservationUser")
  approvedReservations             Reservation[]                   @relation("ReservationApprover")
  approvedMeetingRoomReservations  MeetingRoomReservation[]        @relation("MeetingRoomReservationApprover")
  cancelledReservations            Reservation[]                   @relation("ReservationCanceller")
  cancelledMeetingRoomReservations MeetingRoomReservation[]        @relation("MeetingRoomReservationCanceller")
  cancelledDeskReservations        DeskReservation[]               @relation("DeskReservationCanceller")
  proposedAlternatives             ReservationAlternative[]        @relation("AlternativeProposer")
  createdCapacityExceptions        ResourcePoolCapacityException[] @relation("CapacityExceptionCreator")
  auditLogs                        AuditLog[]                      @relation("AuditActor")
  notifications                    Notification[]                  @relation("NotificationUser")
  createdAnnouncements             Announcement[]                  @relation("AnnouncementCreator")
  announcementReceipts             AnnouncementReceipt[]           @relation("AnnouncementReceiptUser")
  teamMemberships                  TeamMembership[]
  baleConnection                   BaleConnection?
  baleLinkTokens                   BaleLinkToken[]
  baleLunchReportRecipient         BaleLunchReportRecipient?
  createdCalendarDayOverrides      CalendarDayOverride[]           @relation("CalendarDayOverrideCreator")
}

model ResourcePool {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations       Reservation[]
  capacityExceptions ResourcePoolCapacityException[]
}

model ResourcePoolCapacityException {
  id             String   @id @default(cuid())
  resourcePoolId String
  date           DateTime
  capacity       Int
  reason         String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resourcePool ResourcePool @relation(fields: [resourcePoolId], references: [id])
  createdBy    User         @relation("CapacityExceptionCreator", fields: [createdById], references: [id])

  @@unique([resourcePoolId, date])
  @@index([date])
}

model WorkingSchedule {
  id           String   @id @default(cuid())
  /// Uses JavaScript Date.getDay(): Sunday=0, Monday=1, ..., Friday=5, Saturday=6.
  dayOfWeek    Int      @unique
  isWorkingDay Boolean  @default(true)
  startTime    String
  endTime      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduleException {
  id           String                  @id @default(cuid())
  date         DateTime                @unique
  isWorkingDay Boolean
  startTime    String?
  endTime      String?
  reason       String?
  source       ScheduleExceptionSource @default(MANUAL)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model CalendarDayOverride {
  id          String                  @id @default(cuid())
  date        DateTime                @unique
  mode        CalendarDayOverrideMode
  startTime   String?
  endTime     String?
  reason      String?
  createdById String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  createdBy User                        @relation("CalendarDayOverrideCreator", fields: [createdById], references: [id])
  targets   CalendarDayOverrideTarget[]

  @@index([date])
}

model CalendarDayOverrideTarget {
  id         String                @id @default(cuid())
  overrideId String
  type       CalendarDayTargetType
  targetKey  String
  createdAt  DateTime              @default(now())

  override CalendarDayOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@unique([overrideId, type, targetKey])
  @@index([type, targetKey])
}

model MeetingRoom {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  location               String?
  isActive               Boolean   @default(true)
  sortOrder              Int       @default(0)
  autoApprovalEnabled    Boolean   @default(false)
  autoApprovalDelayHours Int       @default(4)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  weeklySchedules MeetingRoomWeeklySchedule[]
  exceptions      MeetingRoomScheduleException[]
  reservations    MeetingRoomReservation[]

  @@index([isActive, sortOrder, name])
}

model MeetingRoomWeeklySchedule {
  id           String   @id @default(cuid())
  roomId       String
  /// Uses JavaScript Date.getDay(): Sunday=0, Monday=1, ..., Friday=5, Saturday=6.
  dayOfWeek    Int
  isWorkingDay Boolean  @default(true)
  startTime    String
  endTime      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, dayOfWeek])
  @@index([dayOfWeek])
}

model MeetingRoomScheduleException {
  id           String   @id @default(cuid())
  roomId       String
  date         DateTime
  isWorkingDay Boolean
  startTime    String?
  endTime      String?
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
}

model Office {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  desks           Desk[]
  weeklySchedules OfficeWeeklySchedule[]
  exceptions      OfficeScheduleException[]

  @@index([deletedAt])
  @@index([active, sortOrder, name])
}

model Desk {
  id        String   @id @default(cuid())
  officeId  String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office       Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  reservations DeskReservation[]

  @@unique([officeId, name])
  @@index([officeId, active, sortOrder, name])
}

model OfficeWeeklySchedule {
  id           String   @id @default(cuid())
  officeId     String
  /// Uses JavaScript Date.getDay(): Sunday=0, Monday=1, ..., Friday=5, Saturday=6.
  dayOfWeek    Int
  isWorkingDay Boolean  @default(true)
  startTime    String
  endTime      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, dayOfWeek])
}

model OfficeScheduleException {
  id           String   @id @default(cuid())
  officeId     String
  date         DateTime
  isWorkingDay Boolean
  startTime    String?
  endTime      String?
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, date])
  @@index([date])
}

model DeskSettings {
  id                     String   @id @default("default")
  maxAdvanceDays         Int      @default(14)
  autoApprovalEnabled    Boolean  @default(false)
  autoApprovalDelayHours Int      @default(4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ReservationPolicy {
  id                          String   @id @default("default")
  dailyUserHourLimit          Int      @default(3)
  oneReservationPerDayEnabled Boolean  @default(true)
  autoAcceptEnabled           Boolean  @default(false)
  autoAcceptDelayHours        Int      @default(4)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model LunchSettings {
  id                            String   @id @default("default")
  maxAdvanceDays                Int      @default(7)
  cutoffTime                    String   @default("23:59")
  enabled                       Boolean  @default(true)
  includeBreakfastNamesInReport Boolean  @default(false)
  includeLunchNamesInReport     Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model LunchLocation {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations LunchReservation[]

  @@unique([name])
  @@index([active])
}

model LunchWeeklySchedule {
  id           String   @id @default(cuid())
  /// Uses JavaScript Date.getDay(): Sunday=0, Monday=1, ..., Friday=5, Saturday=6.
  dayOfWeek    Int      @unique
  isServiceDay Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LunchException {
  id           String   @id @default(cuid())
  date         DateTime @unique
  isServiceDay Boolean
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

model LunchReservation {
  id                  String                 @id @default(cuid())
  userId              String
  locationId          String
  sourceReservationId String?
  date                DateTime
  breakfastReserved   Boolean                @default(false)
  lunchReserved       Boolean                @default(true)
  status              LunchReservationStatus @default(ACTIVE)
  cancelledAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user              User           @relation("LunchReservationUser", fields: [userId], references: [id])
  location          LunchLocation  @relation(fields: [locationId], references: [id])
  sourceReservation Reservation?   @relation(fields: [sourceReservationId], references: [id], onDelete: SetNull)
  notifications     Notification[]

  @@index([userId, date])
  @@index([locationId, date])
  @@index([sourceReservationId])
  @@index([status, date])
}

model Reservation {
  id              String            @id @default(cuid())
  userId          String
  resourcePoolId  String
  startAt         DateTime
  endAt           DateTime
  partySize       Int               @default(1)
  status          ReservationStatus @default(PENDING)
  reason          String?
  rejectionReason String?
  autoAcceptAt    DateTime?
  approvedById    String?
  approvedAt      DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user                   User                     @relation("ReservationUser", fields: [userId], references: [id])
  resourcePool           ResourcePool             @relation(fields: [resourcePoolId], references: [id])
  approvedBy             User?                    @relation("ReservationApprover", fields: [approvedById], references: [id])
  cancelledBy            User?                    @relation("ReservationCanceller", fields: [cancelledById], references: [id])
  alternatives           ReservationAlternative[]
  linkedFoodReservations LunchReservation[]
  notifications          Notification[]

  @@index([resourcePoolId, startAt, endAt])
  @@index([status, startAt])
  @@index([userId, startAt])
}

model MeetingRoomReservation {
  id              String            @id @default(cuid())
  roomId          String
  userId          String
  startAt         DateTime
  endAt           DateTime
  status          ReservationStatus @default(PENDING)
  title           String?
  rejectionReason String?
  autoApprovalAt  DateTime?
  approvedById    String?
  approvedAt      DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  room          MeetingRoom    @relation(fields: [roomId], references: [id])
  user          User           @relation("MeetingRoomReservationUser", fields: [userId], references: [id])
  approvedBy    User?          @relation("MeetingRoomReservationApprover", fields: [approvedById], references: [id])
  cancelledBy   User?          @relation("MeetingRoomReservationCanceller", fields: [cancelledById], references: [id])
  notifications Notification[]

  @@index([roomId, startAt, endAt])
  @@index([status, startAt])
  @@index([userId, startAt])
}

model DeskReservation {
  id             String            @id @default(cuid())
  deskId         String
  userId         String
  startAt        DateTime
  endAt          DateTime
  status         ReservationStatus @default(PENDING)
  autoApprovalAt DateTime?
  approvedAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  desk          Desk           @relation(fields: [deskId], references: [id])
  user          User           @relation("DeskReservationUser", fields: [userId], references: [id])
  cancelledBy   User?          @relation("DeskReservationCanceller", fields: [cancelledById], references: [id])
  notifications Notification[]

  @@index([deskId, startAt, endAt])
  @@index([status, startAt])
  @@index([userId, startAt])
}

model ReservationAlternative {
  id              String            @id @default(cuid())
  reservationId   String
  proposedStartAt DateTime
  proposedEndAt   DateTime
  proposedById    String
  status          AlternativeStatus @default(PROPOSED)
  respondedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  proposedBy  User        @relation("AlternativeProposer", fields: [proposedById], references: [id])

  @@index([reservationId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  severity    AnnouncementSeverity @default(NORMAL)
  audience    AnnouncementAudience @default(ALL)
  startsAt    DateTime             @default(now())
  endsAt      DateTime?
  requiresAck Boolean              @default(false)
  active      Boolean              @default(true)
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User                  @relation("AnnouncementCreator", fields: [createdById], references: [id])
  receipts  AnnouncementReceipt[]

  @@index([active, startsAt, endsAt])
  @@index([audience])
}

model AnnouncementReceipt {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  seenAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation("AnnouncementReceiptUser", fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId, acknowledgedAt])
}

model Notification {
  id                       String    @id @default(cuid())
  userId                   String
  reservationId            String?
  meetingRoomReservationId String?
  lunchReservationId       String?
  deskReservationId        String?
  type                     String
  title                    String
  body                     String
  readAt                   DateTime?
  createdAt                DateTime  @default(now())

  user                   User                      @relation("NotificationUser", fields: [userId], references: [id])
  reservation            Reservation?              @relation(fields: [reservationId], references: [id])
  meetingRoomReservation MeetingRoomReservation?   @relation(fields: [meetingRoomReservationId], references: [id])
  lunchReservation       LunchReservation?         @relation(fields: [lunchReservationId], references: [id])
  deskReservation        DeskReservation?          @relation(fields: [deskReservationId], references: [id])
  baleDelivery           BaleNotificationDelivery?

  @@index([userId, readAt])
  @@index([reservationId])
  @@index([meetingRoomReservationId])
  @@index([lunchReservationId])
  @@index([deskReservationId])
}

model BaleConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  chatId    String   @unique
  enabled   Boolean  @default(true)
  linkedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BaleLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model BaleBotState {
  id                     String    @id @default("default")
  updateOffset           Int       @default(0)
  lastSyncStartedAt      DateTime?
  lastSyncSucceededAt    DateTime?
  lastSyncFailedAt       DateTime?
  lastSyncError          String?
  lastLunchReportCheckAt DateTime?
  updatedAt              DateTime  @updatedAt
}

model BaleNotificationDelivery {
  id             String             @id @default(cuid())
  notificationId String             @unique
  chatId         String
  status         BaleDeliveryStatus @default(SENDING)
  attempts       Int                @default(1)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model BaleLunchReportDelivery {
  id            String             @id @default(cuid())
  deliveryKey   String             @unique
  recipientId   String?
  recipientName String
  reportDate    DateTime
  cutoffAt      DateTime
  chatId        String?
  message       String
  totalCount    Int
  status        BaleDeliveryStatus @default(SENDING)
  attempts      Int                @default(1)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  recipient BaleLunchReportRecipient? @relation(fields: [recipientId], references: [id])

  @@index([status, updatedAt])
  @@index([reportDate, recipientId])
}

model BaleLunchReportRecipient {
  id        String   @id @default(cuid())
  name      String
  chatId    String?  @unique
  userId    String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries BaleLunchReportDelivery[]
  user       User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([active, name])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMembership[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}
